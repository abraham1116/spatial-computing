// Parametric kernels: loops are unrolled at compile time for the requested size.
quantum ghz(n: int) {
    qubit q[n];
    h q[0];
    for i in 0..n - 1 {
        cx q[i], q[i + 1];
    }
}

// QFT followed by its inverse must return |0..0>. The optimiser should cancel most of it.
quantum qft_roundtrip(n: int) {
    qubit q[n];
    for i in 0..n {
        h q[i];
        for j in i + 1..n {
            cp(pi / pow(2, j - i)) q[j], q[i];
        }
    }
    for k in 0..n {
        let i = n - 1 - k;
        for jj in 0..n - 1 - i {
            let j = n - 1 - jj;
            cp(-pi / pow(2, j - i)) q[j], q[i];
        }
        h q[i];
    }
}

main {
    print "ghz(5):", sample ghz(5) shots 1000;
    print "qft roundtrip(4):", sample qft_roundtrip(4) shots 200;
}
