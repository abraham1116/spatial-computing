# Public domain that points to this server (DNS A record). Caddy gets the certificate for it.
DOMAIN=console.example.com
# Address users put in their agents and clients: host:port of the hub as reachable from outside
HUB_PUBLIC_ADDR=console.example.com:7700
# Interface the hub port (7700) is published on. 127.0.0.1 = this machine only. Use 0.0.0.0 to let agents and
# clients on other machines connect (explicit choice: the hub is then reachable from the network).
HUB_BIND=127.0.0.1
# Single sign-on (optional): the client secret of your OpenID Connect application (issuer and client id go in the platform command)
OIDC_CLIENT_SECRET=
# Payments (optional): without these the console shows invoices but cannot charge
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# E-mail (optional): without it, reset links stay in the outbox table
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@console.example.com
